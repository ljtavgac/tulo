# Copy this file to .env.local (for local dev) and set real values before deploying.

# The backend API's base URL. The /food page fetches from `${API_URL}/health`.
API_URL=http://localhost:8000

# The site's own public URL, used for canonical URLs, the sitemap, and
# Open Graph tags. Update this once a real domain is connected -- until
# then it falls back to localhost, which is fine for local dev but wrong
# in production (set it in Vercel's project environment variables).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
