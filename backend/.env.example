# Copy this file to .env and fill in real values before deploying.

# The URL of the deployed frontend, used to allow cross-origin requests.
FRONTEND_ORIGIN=http://localhost:3000

# Database connection string. Defaults to a local SQLite file if unset.
# Fine for local dev and for this template-review stage; before real batch
# content goes live this should point at a persistent database (e.g. a
# Render Postgres instance), since Render's free-tier disk is ephemeral.
DATABASE_URL=sqlite:///./tulo.db
