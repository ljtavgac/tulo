# Copy this file to .env and fill in real values before deploying.

# The URL of the deployed frontend, used to allow cross-origin requests.
FRONTEND_ORIGIN=http://localhost:3000

# Database connection string. Defaults to a local SQLite file if unset.
# Fine for local dev and for this template-review stage; before real batch
# content goes live this should point at a persistent database (e.g. a
# Render Postgres instance), since Render's free-tier disk is ephemeral.
DATABASE_URL=sqlite:///./tulo.db

# Optional: real stock photo sourcing (see app/fetch_stock_images.py).
# Free keys: https://unsplash.com/developers and https://www.pexels.com/api/
# Leave unset and the app works exactly as before -- pages just keep
# showing the placeholder image slot instead of a real photo.
UNSPLASH_ACCESS_KEY=
PEXELS_ACCESS_KEY=

# Optional: must match the frontend's own REVALIDATION_TOKEN. When both are
# set, this service tells the frontend to refresh its page cache right
# after new stock photos are written, instead of a page that was already
# cached before its photo existed showing that stale "no photo" snapshot
# for up to an hour. Leave unset and image fetching still works exactly
# the same -- pages just pick up new photos on their own cache schedule.
REVALIDATION_TOKEN=
